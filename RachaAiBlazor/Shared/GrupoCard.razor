@using RachaAiBlazor.Models

<div class="card shadow-sm mb-3">

    <div class="card-body d-flex justify-content-between align-items-center">

        <div>
            <h5 class="fw-bold">
                @Grupo.Nome
            </h5>

            <span class="badge bg-primary">
                @Grupo.Categoria
            </span>
        </div>

        <div>
            <h5 class="@(Grupo.NoVermelho ? "text-danger" : "text-success")">
                @Grupo.ValorPendente.ToString("C")
            </h5>
        </div>

    </div>

</div>

@code {

    [Parameter]
    public Grupo Grupo { get; set; } = new();

}